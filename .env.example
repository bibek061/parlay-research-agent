# Optional: shared API-Sports key for the six supplied hosts (+ NFL).
API_SPORTS_KEY=
# Optional overrides: API_SPORTS_SOCCER_KEY, API_SPORTS_NBA_KEY,
# API_SPORTS_BASEBALL_KEY, API_SPORTS_BASKETBALL_KEY,
# API_SPORTS_HOCKEY_KEY, API_SPORTS_AFL_KEY, API_SPORTS_NFL_KEY.

# Primary odds provider: https://dash.the-odds-api.com/api
THE_ODDS_API_KEY=
# One region by default to conserve credits. Options: us,us2,uk,eu,au.
THE_ODDS_API_REGIONS=us

# Optional alternative at github.com/odds-api/odds-api (odds-api.net).
# These are different services; never put a The Odds API key here.
ODDS_API_KEY=

# Public ESPN schedules, game odds and player history fallback.
ESPN_FALLBACK_ENABLED=true

# Generate a random token for protected daily snapshot requests.
RESEARCH_API_TOKEN=
RESEARCH_URL=http://127.0.0.1:3000
PORT=3000
